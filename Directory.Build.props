<Project>

  <PropertyGroup>
    <!-- Single switch for the whole solution.
         ODC's External Logic runtime historically pinned .NET 6, then .NET 8.
         The OutSystems.ExternalLibraries.SDK package ships net6.0/net8.0/netstandard2.0
         only, so net10.0 binds against its netstandard2.0 facade. If the ODC portal
         rejects the upload or the library faults at runtime, change this one value
         to net8.0 and rebuild - nothing else in the solution needs to move. -->
    <OsTargetFramework>net10.0</OsTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
